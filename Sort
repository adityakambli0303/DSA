#include<stdio.h>
#include<stdlib.h>

void bubblesort();
void selectionsort();

int main()
{
    int ch;

    while(1)
    {
        printf("\n1. Bubble Sort");
        printf("\n2. Selection Sort");
        printf("\n3. Exit");
        printf("\nEnter your choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1:
                bubblesort();
                break;

            case 2:
                selectionsort();
                break;

            case 3:
                exit(0);

            default:
                printf("Invalid choice");
        }
    }
}

void bubblesort()
{
    int a[50],n,i,j,temp;

    printf("Enter number of students: ");
    scanf("%d",&n);

    printf("Enter percentages:\n");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    for(i=0;i<n-1;i++)
    {
        for(j=0;j<n-1-i;j++)
        {
            if(a[j]>a[j+1])
            {
                temp=a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
            }
        }
    }

    printf("Sorted percentages:\n");
    for(i=0;i<n;i++)
        printf("%d ",a[i]);

    printf("\nTop Five Scores:\n");
    for(i=n-1;i>=0 && i>=n-5;i--)
        printf("%d ",a[i]);

    printf("\n");
}

void selectionsort()
{
    int a[50],n,i,j,temp,min;

    printf("Enter number of students: ");
    scanf("%d",&n);

    printf("Enter percentages:\n");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    for(i=0;i<n-1;i++)
    {
        min=i;

        for(j=i+1;j<n;j++)
        {
            if(a[j]<a[min])
                min=j;
        }

        temp=a[i];
        a[i]=a[min];
        a[min]=temp;
    }

    printf("Sorted percentages:\n");
    for(i=0;i<n;i++)
        printf("%d ",a[i]);

    printf("\nTop Five Scores:\n");
    for(i=n-1;i>=0 && i>=n-5;i--)
        printf("%d ",a[i]);

    printf("\n");
}
