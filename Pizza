#include <stdio.h>
#define MAX 5
int queue[MAX];
int front = -1;
int rear = -1;

void enqueue()
{
    int order;

    if (rear == MAX - 1)
    {
        printf("Queue Overflow! No more orders can be accepted.\n");
    }
    else
    {
        printf("Enter order number: ");
        scanf("%d", &order);

        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = order;

        printf("Order added successfully.\n");
    }
}


void dequeue()
{
    if (front == -1 || front > rear)
    {
        printf("Queue Underflow! No orders to serve.\n");
    }
    else
    {
        printf("Order served: %d\n", queue[front]);
        front++;

        if (front > rear)
            front = rear = -1;
    }
}


void display()
{
    int i;

    if (front == -1)
    {
        printf("Queue is empty.\n");
    }
    else
    {
        printf("Current orders: ");

        for (i = front; i <= rear; i++)
        {
            printf("%d ", queue[i]);
        }

        printf("\n");
    }
}

int main()
{
    int ch;

    while (1)
    {
        printf("\n--- PIZZA PARLOR ---\n");
        printf("1. Add Order\n");
        printf("2. Serve Order\n");
        printf("3. Display Orders\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                enqueue();
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
